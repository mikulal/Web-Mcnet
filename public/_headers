/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# Kopie na pages.dev se nemají indexovat (produkční i náhledové nasazení).
# Indexovatelná je jen finální doména www.mcnet.cz. Adresa zůstává dostupná, bez přesměrování.
https://web-mcnet.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.web-mcnet.pages.dev/*
  X-Robots-Tag: noindex
